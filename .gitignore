__pycache__/
*.py[cod]

# Runtime event store; EventStore creates this next to store.py by default.
*.db
smartbin.db

# Frames written on every trigger. Useful on the board, not in git.
python/captures/

# Model weights, fetched by classification/download_models.py. The project
# directory is bind-mounted from the board's real filesystem, so they survive
# redeploys without being committed - the default model alone is ~20 MB.
python/classification/models/

# App Lab sketch build artifacts (~490 MB on the board).
.cache/

# Cloud API key. Never committed.
python/.cloud_key
